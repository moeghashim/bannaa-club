# Copy this file to /opt/forem/config/forem.env on the VPS.
# Fill real values on the server only. Do not commit real secrets.

RAILS_ENV=production
RACK_ENV=production
NODE_ENV=production
RAILS_SERVE_STATIC_FILES=true

APP_DOMAIN=club.bannaa.ai
APP_PROTOCOL=https://
DEFAULT_LOCALE=ar
# Add your public community name here.
COMMUNITY_NAME=REQUIRED_FROM_USER_COMMUNITY_NAME
DEFAULT_EMAIL=no-reply@club.bannaa.ai
FOREM_OWNER_SECRET=GENERATE_ON_VPS
SESSION_KEY=_club_bannaa_ai_session
SESSION_EXPIRY_SECONDS=1209600
FORCE_SSL_IN_RAILS=true
RACK_TIMEOUT_WAIT_TIMEOUT=10000
RACK_TIMEOUT_SERVICE_TIMEOUT=10000

SECRET_KEY_BASE=GENERATE_ON_VPS
FOREM_IMAGE=ghcr.io/moeghashim/bannaa-club:production

POSTGRES_DB=forem_production
POSTGRES_USER=forem
POSTGRES_PASSWORD=GENERATE_ON_VPS
DATABASE_URL=postgres://forem:GENERATE_ON_VPS@postgres:5432/forem_production

REDIS_URL=redis://redis:6379/0
REDIS_SESSIONS_URL=redis://redis:6379/1
REDIS_SIDEKIQ_URL=redis://redis:6379/2
REDIS_RPUSH_URL=redis://redis:6379/3

SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_DOMAIN=club.bannaa.ai
SMTP_USER_NAME=resend
# Add your Resend API key here on the VPS only.
SMTP_PASSWORD=REQUIRED_FROM_USER_RESEND_API_KEY
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Optional object storage. Leave blank for first KVM1 proof of concept.
AWS_ID=
AWS_SECRET=
AWS_UPLOAD_REGION=
AWS_BUCKET_NAME=

# Optional but recommended for production search once initial deploy is stable.
ALGOLIA_APPLICATION_ID=
ALGOLIA_API_KEY=
ALGOLIA_SEARCH_ONLY_API_KEY=

# Optional production services.
HONEYBADGER_API_KEY=
HONEYBADGER_JS_API_KEY=
GA_ANALYTICS_4_ID=
RECAPTCHA_SITE=
RECAPTCHA_SECRET=
